# Copy to .env (running with npm start) or life-dash.env next to compose.yml (Docker) and fill in.
# In Docker, HOST, PORT and DB_PATH are set by compose.yml and the values here are ignored.

# Required: random string used to encrypt stored Oura tokens. Generate with: openssl rand -hex 32
SECRET_KEY=

# The address people use to reach the dashboard. Oura redirects back to PUBLIC_URL/api/oura/callback.
PUBLIC_URL=http://localhost:8080
HOST=127.0.0.1
PORT=8080

# Where the SQLite database lives (default: var/life-dash.db inside the app folder)
# DB_PATH=var/life-dash.db

# Set to true when running behind a reverse proxy (nginx, Caddy) so login throttling sees real client IPs.
# TRUST_PROXY=true

# Oura OAuth app (create one in the Oura developer portal; set its redirect URI to PUBLIC_URL/api/oura/callback)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# OURA_SCOPES=personal daily
# SYNC_INTERVAL_MINUTES=60
# OURA_BACKFILL_DAYS=90

# SESSION_DAYS=30
# MAX_UPLOAD_MB=20
