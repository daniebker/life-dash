# systemd unit for the Life Dash server.
# Install: sudo cp deploy/life-dash.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now life-dash
# Adjust User and WorkingDirectory to match your server. Settings live in /etc/life-dash.env (see .env.example).
[Unit]
Description=Life Dash
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lifedash
Group=lifedash
WorkingDirectory=/srv/life-dash
EnvironmentFile=/etc/life-dash.env
ExecStart=/usr/bin/node server/server.mjs
Restart=on-failure
RestartSec=5

# The database lives in /var/lib/life-dash (set DB_PATH=/var/lib/life-dash/life-dash.db in /etc/life-dash.env)
StateDirectory=life-dash
StateDirectoryMode=0700
ReadWritePaths=/var/lib/life-dash

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
